# Copier en .env sur le NAS (cp .env.production.example .env), puis remplir. Jamais commité.
# Générer un secret : openssl rand -hex 32

# Base MongoDB (le conteneur la crée au premier démarrage)
MONGO_ROOT_USER=flotte
MONGO_ROOT_PASSWORD=remplacer-par-un-mot-de-passe-long
MONGO_DB=bt_flotte

# Signature des sessions (64 caractères aléatoires)
AUTH_SECRET=remplacer-par-openssl-rand-hex-32

# Port de l'application sur le NAS (réseau local)
APP_PORT=3000

# true : connexion uniquement en HTTPS (accès par le nom de domaine). Recommandé.
# false : autorise aussi la connexion en HTTP simple via http://IP-DU-NAS:3000 (moins sûr).
COOKIE_SECURE=true

# Jeton du tunnel Cloudflare (Zero Trust > Networks > Tunnels > votre tunnel > Docker)
CLOUDFLARE_TUNNEL_TOKEN=

# Compte admin initial, utilisé UNE fois par « npm run user:admin », puis à vider
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrateur
