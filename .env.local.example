# Base MongoDB (127.0.0.1 plutôt que localhost : MongoDB n'écoute pas toujours en IPv6 sous Windows)
MONGODB_URI=mongodb://127.0.0.1:27017/bt_flotte

# Secret de signature du cookie de session (chaîne longue et aléatoire)
AUTH_SECRET=remplacer-par-une-chaine-aleatoire

# Compte gestionnaire créé par « npm run user:admin » (8 caractères minimum)
ADMIN_EMAIL=gestionnaire@bt.local
ADMIN_PASSWORD=remplacer-par-un-mot-de-passe
ADMIN_NAME=Gestionnaire
